# Copy to backend/.env and adjust.
APP_ENV=dev
LOG_LEVEL=INFO

# Your existing MongoDB (e.g. the `mongo` Docker container on port 27017).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=intervia

# Login. false = everyone is the default user (MVP-1 without accounts).
AUTH_ENABLED=true
# Safari drops Secure cookies on http://localhost; keep false only in dev.
AUTH_COOKIE_SECURE=false

# Vite dev server origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173
