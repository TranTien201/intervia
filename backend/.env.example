# Copy to backend/.env and adjust.
APP_ENV=dev
LOG_LEVEL=INFO

# Your existing MongoDB (e.g. the `mongo` Docker container on port 27017).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=intervia

# Login. false = everyone is the default user (MVP-1 without accounts).
AUTH_ENABLED=true
# Safari drops Secure cookies on http://localhost; keep false only in dev.
AUTH_COOKIE_SECURE=false

# Vite dev server origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173

# CV / JD extraction. `fake` (default) needs no key: every CV gives the same sample profile.
# `llamacloud` needs LLAMA_CLOUD_API_KEY (https://cloud.llamaindex.ai), else the app won't start.
EXTRACTOR_PROVIDER=fake
# LLAMA_CLOUD_API_KEY=
# LlamaExtract plan per quality: economy = modes standard/layout, high = mode precise.
# LLAMA_TIER_ECONOMY=cost_effective
# LLAMA_TIER_HIGH=agentic
# EXTRACT_MAX_PAGES=6
# EXTRACT_TIMEOUT_S=180
